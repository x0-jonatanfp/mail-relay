{
  "name": "mail-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SMTP relay para formularios de contacto - Reutilizable para multiples proyectos",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "serve": "node dist/index.js",
    "test": "vitest run",
    "restart": "systemctl --user restart mail-relay.service",
    "status": "systemctl --user status mail-relay.service",
    "logs": "journalctl --user -u mail-relay.service -n 50 -f",
    "deploy": "make deploy"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "js-yaml": "^4.1.0",
    "nodemailer": "^6.9.0",
    "pg": "^8.21.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9"
  }
}
