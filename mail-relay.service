[Unit]
Description=Mail Relay - Relay de formularios de contacto multi-cliente
Documentation=https://github.com/x0-jonatanfp/mail-relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/services/mail-relay
ExecStart=/usr/bin/node /srv/services/mail-relay/dist/index.js
Restart=on-failure
RestartSec=5
StartLimitBurst=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
